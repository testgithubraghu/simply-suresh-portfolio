# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets such as email API keys)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# licensed fonts (Gellix files must not be pushed to a public repo)
/public/fonts/gellix/*.woff
/public/fonts/gellix/*.woff2
/public/fonts/gellix/*.ttf
/public/fonts/gellix/*.otf
!/public/fonts/gellix/README.md